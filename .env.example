# ── DATABASE ─────────────────────────────────────────────────────────────────
# Supabase: Settings → Database → URI → copy and replace [YOUR-PASSWORD]
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ── JWT AUTH ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY is REQUIRED in production — the app refuses to start with the
# placeholder value unless DEBUG=true.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
# Token lifetime in minutes. Keep this short-ish (720 = 12h / one shift).
# Do NOT set this to multi-week values — stolen tokens stay valid until expiry.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── ENVIRONMENT ──────────────────────────────────────────────────────────────
# DEBUG=true enables local dev conveniences and relaxes the SECRET_KEY check.
# Leave false/unset in production.
DEBUG=false
# EXPOSE_DOCS=true serves /docs, /redoc and /openapi.json. Keep false in
# production so the full API surface is not published to anonymous users.
EXPOSE_DOCS=false

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ── DELIVERY WEBHOOKS (optional — global fallback; per-restaurant secret preferred) ──
# Provided by Zomato/Swiggy. Leave blank in dev to skip signature verification.
ZOMATO_WEBHOOK_SECRET=
SWIGGY_WEBHOOK_SECRET=

# ── RAZORPAY (add later) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
